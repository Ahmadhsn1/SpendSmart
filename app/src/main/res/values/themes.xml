<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base theme. Everything shared by every API level lives here.

        android:windowLightNavigationBar is deliberately NOT set here — it was
        introduced in API 27 and minSdk is 24. It is layered on in
        res/values-v27/themes.xml so older devices never see an attribute they
        cannot resolve.
    -->
    <style name="Base.Theme.SpendSmart" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- The theme the manifest actually points at. -->
    <style name="Theme.SpendSmart" parent="Base.Theme.SpendSmart" />

    <!-- Splash Theme - Fullscreen -->
    <style name="Theme.SpendSmart.Splash" parent="Theme.SpendSmart">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- Auth Theme -->
    <style name="Theme.SpendSmart.Auth" parent="Theme.SpendSmart">
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- Custom Button Style -->
    <style name="Widget.SpendSmart.Button" parent="Widget.Material3.Button">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Outlined Button Style -->
    <style name="Widget.SpendSmart.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="strokeColor">@color/primary</item>
    </style>

    <!-- TextInputLayout Style -->
    <style name="Widget.SpendSmart.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/border</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.SpendSmart.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

</resources>
